# Georgia Gold Network — environment
# Copy to .env and fill in. NEVER commit .env.

# ---------------------------------------------------------------------------
# Database — Neon Postgres
# ---------------------------------------------------------------------------
# DATABASE_URL must be the POOLED endpoint (host contains "-pooler"). Serverless opens a fresh
# connection per cold start; without the pooler in front, a traffic spike exhausts Postgres
# connections and every request starts failing.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL must be the UNPOOLED endpoint. The Prisma CLI (db push / migrate) runs DDL, and a
# transaction pooler cannot — using the pooled URL here fails in confusing ways.
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Secrets — generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
# Signs the session JWT. Must be at least 32 characters. If this is weak or shared, anyone can
# mint a cookie claiming ADMIN.
SESSION_SECRET=""

# Salts every hash of personal data (IPs, phone numbers, emails, lead dedupe keys). An UNSALTED
# hash of a 10-digit US phone number is brute-forceable in seconds, so this is not optional.
# Changing it orphans existing dedupe keys — rotate deliberately, not casually.
HASH_SALT=""

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# MUST be set in production. If it is unset, sitemap.xml advertises localhost URLs to Google.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Gold spot price  (Phase 1)
# ---------------------------------------------------------------------------
# Options considered: MetalpriceAPI, GoldAPI.io, UniRateAPI (free tier 200 req/day, Pro $9/mo).
# Responses are cached into SpotPriceSnapshot, which doubles as the audit trail for what price
# a given bid or valuation was made against.
GOLD_API_PROVIDER="metalpriceapi"
GOLD_API_KEY=""

# ---------------------------------------------------------------------------
# Call tracking — Twilio  (Phase 2)
# ---------------------------------------------------------------------------
# Twilio direct rather than Ringba ($147–297/mo) or Retreaver (~$0.05/min): we are building the
# routing layer anyway, and Twilio's $0.0085/min inbound is roughly 6x cheaper per minute.
# Numbers cost $1.15/month each.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_STATUS_CALLBACK_URL=""

# ---------------------------------------------------------------------------
# Email  (Phase 2)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM=""
